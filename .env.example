# ---------------------------------------------------------------------------
# Sözleşme Feneri — ortam ayarları
#
#   cp .env.example .env      ve kendi değerlerinizi yazın
#   docker compose up -d      (compose bu dosyayı otomatik okur)
#
# .env dosyası .gitignore'dadır; anahtarlarınız depoya girmez.
# Anahtarı buraya yazmak zorunda değilsiniz — uygulamadaki "Model ayarları"
# panelinden de girebilirsiniz (kalıcı birimde saklanır).
# ---------------------------------------------------------------------------

# --- Model sağlayıcı ------------------------------------------------------
# auto | anthropic | openai | gemini | custom | heuristic
# auto = anahtarı olan ilk sağlayıcıyı kullanır. Hiçbiri yoksa kural tabanlı çalışır.
LLM_PROVIDER=auto

# Claude — Anthropic
ANTHROPIC_API_KEY=
MODEL_MAIN=claude-opus-5

# ChatGPT — OpenAI
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
MODEL_OPENAI=gpt-4.1

# Gemini — Google
GOOGLE_API_KEY=
MODEL_GEMINI=gemini-flash-latest
MODEL_GEMINI_CHEAP=gemini-flash-lite-latest

# Diğer — OpenAI sohbet protokolünü konuşan HERHANGİ bir servis.
# Anahtar için OPENAI_API_KEY alanı kullanılır.
#   DeepSeek    https://api.deepseek.com/v1              deepseek-chat
#   Qwen        https://dashscope-intl.aliyuncs.com/compatible-mode/v1   qwen-plus
#   Groq        https://api.groq.com/openai/v1           llama-3.3-70b-versatile
#   OpenRouter  https://openrouter.ai/api/v1             deepseek/deepseek-chat
#   Ollama      http://localhost:11434/v1                qwen2.5:14b   (anahtar gerekmez)
#   vLLM        http://localhost:8000/v1                 (sunucudaki model adı)
CUSTOM_BASE_URL=
MODEL_CUSTOM=

# --- Maliyet tavanları ----------------------------------------------------
# Aşılınca model KAPANIR; analiz kural katmanıyla tamamlanır, çökmez.
MAX_LLM_CALLS=80
MAX_COST_USD=1.00
MAX_TOTAL_TOKENS=400000
LLM_DEADLINE_SECONDS=900
LLM_TIMEOUT_SECONDS=90
MAX_CONSECUTIVE_FAILURES=3
# Gecici saglayici hatasi (503/429) yeniden denenir. Kalici hata (gecersiz
# anahtar, biten kota, desteklenmeyen model) denenmez - beklemek cozmez.
LLM_RETRY_ATTEMPTS=3
LLM_RETRY_BACKOFF_SECONDS=2
# Modele gönderilecek azami madde (ağırlığa göre seçilir). 0 = sınırsız.
MAX_LLM_CLAUSES=40
ENABLE_LENSES=1
ENABLE_REBUTTAL=1

# --- OCR (taranmış belgeler) ---------------------------------------------
OCR_ENABLED=1
OCR_LANG=tur+eng
# Raspberry Pi'de 200 önerilir: 300 dpi bellek ve CPU'yu ciddi zorlar.
OCR_DPI=300
OCR_MAX_PAGES=60

# --- Dayanıklılık ---------------------------------------------------------
STAGE_MAX_ATTEMPTS=3
ITEM_MAX_ATTEMPTS=2
ORPHAN_AFTER_SECONDS=90
SWEEPER_ENABLED=1
MAX_UPLOAD_MB=40

# --- Kimlik doğrulama ---  ⚠ ÜRETİMDE ZORUNLU
# Boş bırakırsanız ilk açılışta rastgele parola üretilir ve sunucu loguna yazılır.
APP_PASSWORD=
# Oturum çerezi imza sırrı — rastgele uzun bir dize verin. Değişirse oturumlar düşer.
SESSION_SECRET=
SESSION_HOURS=12
# HTTPS (ters vekil) arkasındaysanız 1 yapın.
COOKIE_SECURE=0
# 0 yalnızca yerel geliştirme içindir; üretimde ASLA kapatmayın.
AUTH_ENABLED=1

# --- Ağ -------------------------------------------------------------------
# Dışarıya açılan port (varsayılan http://localhost:8099)
HOST_PORT=8099
